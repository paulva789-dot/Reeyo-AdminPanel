# Admin API base URL.
#
# Dev: leave as /api/v1 — vite.config.ts proxies it to the local admin-api so
# the HTTP-only auth cookies are same-origin and actually get set.
#   /api/v1 -> http://localhost:3005/api/v1
#
# To develop against the deployed backend instead, point VITE_PROXY_TARGET at
# it rather than changing this value, so cookies stay same-origin:
#   VITE_PROXY_TARGET=https://admin-api.usereeyo.com
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api/v1. Defaults to the local admin-api.
VITE_PROXY_TARGET=http://localhost:3005
