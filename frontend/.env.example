# Admin API (see docs: Admin API Integration Reference)
# Dev: proxied through Vite at /api/v1 (see vite.config.ts) -> http://localhost:3005/api/v1
# Prod: point directly at the deployed admin-api origin.
VITE_API_BASE_URL=/api/v1

# Supabase (only used where noted in src/lib/supabase.js; not the admin-api auth path)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
