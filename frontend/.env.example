# Admin API base URL.
#
# Leave this as /api/v1 in both dev and production. In dev, vite.config.ts
# proxies it; in production, vercel.json rewrites it. Both exist for the same
# reason: the admin-api's HTTP-only auth cookies only work if the browser sees
# the API on the same origin as the console.
#
#   dev         /api/v1 -> VITE_PROXY_TARGET (see below)
#   production  /api/v1 -> https://admin-api.usereeyo.com/api/v1, via Vercel
#
# Pointing this straight at https://admin-api.usereeyo.com/api/v1 makes every
# request cross-origin, and the deployed API answers 500 — not a clean CORS
# rejection — for any origin outside its ALLOWED_ORIGINS allowlist.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api/v1. Defaults to the deployed admin-api,
# which is the one that is usually up. Set this to http://localhost:3005 when
# you are running admin-api locally.
# VITE_PROXY_TARGET=http://localhost:3005

# The origin the dev proxy presents to a remote backend. Only used when
# VITE_PROXY_TARGET is https, because the deployed API 500s on any origin it
# does not recognise. Must be one of its allowlisted origins.
# VITE_PROXY_ORIGIN=https://admin.usereeyo.com
