# Production build-time config, loaded automatically by `vite build`.
# Not secret — this is the public admin-api origin. Verified reachable
# 2026-08-22 (returns the standard error envelope on an unauthenticated call).
#
# If the hosting platform sets VITE_API_BASE_URL in its own dashboard, that
# wins over this file; this exists so the correct value ships regardless of
# which platform runs the build.
#
# Note: in production the console is served from a different origin to the API,
# so the backend must send its auth cookies with SameSite=None; Secure and
# allow this origin via CORS with credentials.
VITE_API_BASE_URL=https://admin-api.usereeyo.com/api/v1
