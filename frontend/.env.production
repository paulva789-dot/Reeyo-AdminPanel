# Production build-time config, loaded automatically by `vite build`
# (mode defaults to "production"). Not secret — this is just the public
# admin-api URL, confirmed live 2026-08-14.
#
# If the hosting platform also sets VITE_API_BASE_URL in its own dashboard,
# that takes precedence over this file — this exists as a portable fallback
# so the correct value ships regardless of which platform builds the repo.
VITE_API_BASE_URL=https://admin-api.usereeyo.com/api/v1
